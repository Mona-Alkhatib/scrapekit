,"title":"Canada and Toronto announce new partnership to build thousands of new homes","source":"","copyright":""},"is_external_url":true}]}]}],"currentUse":"TPA parking lot (1117 Dundas St W) and vacant residential building (1113 Dundas St W) ","initiative":"a22c3ccc-cfc0-48c9-800d-345fc4ed58af","initiatives":[{"name":"Housing","created_at":"2023-10-26T17:45:31.405Z","published_at":"2026-08-12T15:56:48.549Z","updated_at":"2026-08-12T15:56:48.567Z","id":481837,"uuid":"a22c3ccc-cfc0-48c9-800d-345fc4ed58af","content":{"_uid":"5d44e371-f8ae-4408-a729-d2b03b44fd90","body":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Toronto is facing an evolving housing crisis, impacting housing affordability for low-income, vulnerable residents including people experiencing homelessness, as well as key workers and middle-income earners.","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"City Council’s HousingTO 2020-2030 Action Plan aims to approve 65,000 rent-controlled homes (including 6,500 rent-geared-to-income (RGI), 41,000 affordable rental and 17,500 rent-controlled market homes) by 2030.","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"By applying a strategic, city-wide lens to Toronto’s real estate holdings, CreateTO is unlocking the potential of City-owned lands to be activated for the public good, including the delivery of more affordable housing, through a suite of programs and policies.","type":"text"}]},{"type":"horizontal_rule"},{"type":"blok","attrs":{"id":"e7ad8e2b-b7ff-41e6-8733-20bfc9afde47","body":[{"_uid":"i-a162afd2-ed79-4982-8f0b-f5f53ec88ffc","title":"CreateTO Housing Tracker","component":"resources","resources":[{"_uid":"25689ab9-927b-4c68-b253-2f8a2b55b045","title":"July 2026","component":"resourcesItem","documents":[{"id":null,"alt":"","name":"","focus":null,"title":"Housing Tracker","source":"","filename":"https://www.toronto.ca/legdocs/mmis/2026/ra/bgrd/backgroundfile-289593.pdf","copyright":"","fieldtype":"asset","meta_data":{"alt":"","title":"Housing Tracker","source":"","copyright":""},"is_external_url":true},{"id":null,"alt":"","name":"","focus":null,"title":"Housing Progress Update - Presentation","source":"","filename":"https://www.toronto.ca/legdocs/mmis/2026/ra/bgrd/backgroundfile-289606.pdf","copyright":"","fieldtype":"asset","meta_data":{"alt":"","title":"Housing Progress Update - Presentation","source":"","copyright":""},"is_external_url":true}]}]}]}},{"type":"horizontal_rule"},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Toronto Builds","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"In 2025, Toronto City Council adopted ","type":"text"},{"text":"Toronto Builds","type":"text","marks":[{"type":"link","attrs":{"href":"https://secure.toronto.ca/council/agenda-item.do?item=2025.PH21.4","uuid":null,"anchor":null,"target":"_blank","linktype":"url"}}]},{"text":" - a new policy framework to guide the development of a range of new rental homes within mixed-income communities on City land. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The Toronto Builds Policy Framework includes specific requirements for housing developments on City-land, including but not limited to:","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Projects on City-owned land will deliver projects with the residential component being 100% purpose-built rental housing in tenure,","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"A minimum of 30% of residential units must be affordable rental housing with no individual project providing less than 20% affordable rental housing,","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Affordable rental homes must meet the City’s Rental Housing Supply Program definition of affordable rental housing, which aligns with the City’s Official Plan income-based definition,","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Affordability must be maintained for a minimum of 40 years and for the duration of any lease,","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"All affordable rental homes must be rent-controlled at the Provincial Rent Increase Guideline as set annually by the Province, up to the maximum allowable affordable rent,","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"City-owned land will be retained in public ownership and will be developed by offering 40 to 99-year leases to developers and/or operators,","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"20% of new affordable rental homes, and 15% of market rental homes, must be accessible, meeting Ontario Building Code requirements for barrier-free.","type":"text"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"CreateTO has also identified key opportunities to deliver affordable housing on other City-owned sites including the former ","type":"text"},{"text":"Toronto Coach Terminal","type":"text","marks":[{"type":"link","attrs":{"href":"/projects/610-bay-street","uuid":"b71dcfb0-fd5e-4f51-beb9-b38b9af40750","anchor":null,"target":"_self","linktype":"story"}}]},{"text":".","type":"text"}]},{"type":"horizontal_rule"},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Housing Now","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Adopted by Toronto City Council in 2019, the Housing Now Initiative invested in City-owned lands across Toronto for the development of affordable housing within mixed-income, mixed-use, transit-oriented communities where every individual has the chance to thrive. ","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Succeeded by the Toronto Builds Policy Framework, Housing Now identified City-owned sites that could be redeveloped to create a mix of affordable rental, market rental and ownership housing options serving Toronto residents. Several CreateTO projects were advanced through the Housing Now Initiative and are currently under construction. Similar to Toronto Builds projects, these new affordable rental homes will remain so for 99 years, providing quality affordable housing for future generations.","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"image","attrs":{"id":114640619492118,"alt":"","src":"https://a-us.storyblok.com/f/1017201/4000x4000/7ee2bd2e9b/2444-eglinton-20241209-final-egl-001_005-patio.jpg","title":"2444 Eglinton Avenue East (Henriquez Partner Architects/CCxA)","source":"","copyright":"","meta_data":{"alt":"","title":"2444 Eglinton Avenue East (Henriquez Partner Architects/CCxA)","source":"","copyright":""}}}]},{"type":"horizontal_rule"},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Modular Housing","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}},{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"CreateTO is a partner in delivering the Modular Housing Initiative – part of the City’s HousingTO 2020-2030 Action Plan and an innovative and cost-effective way to build small-scale infill housing. This will provide a rapid, dignified response to connect people experiencing homelessness with homes and the appropriate supports to help them achieve housing stability.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"horizontal_rule"},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Expanding Housing Options in Neighbourhoods (EHON)","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The primary focus of the EHON initiative, including the Beaches-East York Pilot Project on A","type":"text"},{"text":"mroth Avenue","type":"text","marks":[{"type":"link","attrs":{"href":"/projects/72-amroth-avenue","uuid":"fbcbc6f2-31d2-4b8f-9477-c271a0d1fb0b","anchor":null,"target":"_self","linktype":"story"}}]},{"text":", is the expansion of market housing options, in a range of formats, within the City’s neighbourhoods. While this work will not necessarily result in the creation of affordable housing supply, it will result in a more diverse range of housing forms to support residents with a much broader range of incomes and household compositions at various stages of life.","type":"text"}]},{"type":"horizontal_rule"},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Applying for Affordable Rental Housing","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Current opportunities for affordable rental housing can be found on ","type":"text"},{"text":"the City of Toronto website","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.toronto.ca/community-people/community-partners/housing-partners/affordable-rental-homes/","uuid":null,"anchor":null,"target":null,"linktype":"url"}}]},{"text":".","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The current process is an interim approach used by both private, non-profit and co-operative housing providers.","type":"text"},{"text":"  ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]},{"text":"The City of Toronto is creating a new Centralized Access System for Affordable Rental Housing. This future system will provide a single, consistent way for residents to apply.","type":"text"}]}]},"hero":[{"_uid":"756fc68e-8b3e-4f57-b616-a8e800ce40f2","link":[],"image":{"id":112088908355938,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017201/9504x6336/2ce892959e/5207-dundas-press-conference-156.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"theme":"greenLightest","headline":"Affordable homes. Built for you. Built for our city.","component":"heroWithBackground"}],"logo":{"id":null,"alt":null,"name":"","focus":null,"title":null,"filename":null,"copyright":null,"fieldtype":"asset","meta_data":{},"is_external_url":false},"meta":[],"stats":[{"_uid":"eb05acf0-8a6a-4924-95c1-d8bda2f66d32","stats":[{"_uid":"f9ca94ed-eb29-4d61-b4e8-20481d3af548","label":"Active Housing Sites","value":"39","component":"statsItem"},{"_uid":"27712fc9-6144-4df7-bb18-e761f6912565","label":"Housing Sites Under Construction","value":"6","component":"statsItem"},{"_uid":"3367a118-8d8e-45aa-b9f7-f2eec8013ad9","label":"Affordable Rental Homes","value":"5,674","component":"statsItem"},{"_uid":"7851b120-39ff-45c9-a562-2e28da89c1f5","label":"Homes","value":"20,196","component":"statsItem"}],"title":"","component":"statsEmbed"}],"footer":[{"_uid":"1b12371b-a5a5-47c9-9151-c3496ca782ff","component":"globalComponent","globalComponent":{"name":"Join the conversation (with image)","created_at":"2023-10-26T17:45:29.129Z","published_at":"2025-02-17T16:31:46.312Z","updated_at":"2025-02-17T16:31:46.330Z","id":481736,"uuid":"53f05d2e-b04e-4b1a-b4c9-c7b3bff5ce68","content":{"_uid":"69c67a3a-2627-42aa-bbdf-7e3b6534bfd4","image":{"id":181241,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1015016/611x388/7398c00f7e/join-the-conversation.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"links":["28642ab6-8b3e-48c9-a927-05a2e9a7e815","466909db-4b8a-47ec-9cda-ce294f20872e","abf3e136-d48c-45d0-bf09-ae2690f2b6eb","39bcd9b6-c824-4325-a36e-9af50dc550c3"],"title":"Join the conversation","component":"socialLinks","description":"Follow us on LinkedIn or X and stay up-to-date with the latest happenings at CreateTO! Stay connected by asking questions, giving feedback, and participating in discussions. We value your opinions and want to hear from you."},"slug":"join-the-conversation-with-image","full_slug":"system/globals/join-the-conversation-with-image","sort_by_date":null,"position":0,"tag_list":[],"is_startpage":false,"parent_id":481729,"meta_data":null,"group_id":"f94dca8b-5222-46c5-9e77-27f039cd4351","first_published_at":"2023-09-29T16:13:41.048Z","release_id":null,"lang":"default","path":null,"alternates":[],"default_full_slug":null,"translated_slugs":null,"_stopResolving":true}}],"summary":"CreateTO is leading the delivery of affordable homes on City-owned land.","component":"initiative","components":[{"cta":{"id":"","url":"","linktype":"story","fieldtype":"multilink","cached_url":""},"_uid":"ffa04bf7-d41f-4977-9959-c46c37f1a9e4","tabs":[{"_uid":"03087973-eeb0-451d-99f5-527cb8be8b03","color":"green","title":"Under Construction","blocks":[],"projects":[{"name":"1113-1117 Dundas Street West","created_at":"2023-10-26T17:45:31.405Z","published_at":"2026-08-21T15:29:12.222Z","updated_at":"2026-08-21T15:29:12.256Z","id":481853,"uuid":"8156878d-c5e5-4f40-9bc0-043bbc425705","content":{"_uid":"21c3b6fa-0554-4001-89e3-7b4d317fceaf","body":{"type":"doc","attrs":{"backgroundColor":null},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"1113-1125 Dundas Street West is a new rental housing development on City-owned land in Toronto’s Spadina-Fort York community, led by CreateTO as public builder. As the first CreateTO public builder project to break ground, the development marks an important milestone in a new City-led approach to delivering housing on public land.  ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"CreateTO, on behalf of the City of Toronto, is repurposing the site (formerly occupied by a Green P surface parking lot and a vacant, semi-detached home) to create 74 new rental homes, including at least 17 affordable homes. Designed to support a range of households, the development will include family-sized units in a vibrant, transit-oriented neighbourhood.  ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"By leveraging City-owned land and a City-led delivery model, the project demonstrates how the public sector can help create more housing, faster and efficiently, while supporting affordability and sustainability. The development reflects a collaborative effort between CreateTO and the City of Toronto to advance housing solutions that deliver lasting community benefit. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"Sustainability has been a guiding principle of the project from the outset, as part of the Mass Timber Pilot Program launched by CreateTO and City partners. It explores how innovative, low-carbon construction methods can support faster, more sustainable housing delivery, the development incorporated sustainability at every stage.  ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"In preparation for redevelopment, the vacant home on the site at 1113 Dundas Street West was carefully deconstructed rather than demolished, allowing materials to be diverted from landfill and supporting a more circular approach to construction.  ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"The new building will incorporate mass timber construction, geothermal energy and other low-carbon design strategies to reduce environmental impacts and support a more sustainable community. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"Construction is scheduled to begin in Summer 2026 and continue through 2027. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"This project is supported in part through funding provided by the Government of Canada under Build Canada Homes, supporting the development of affordable and non-market housing.","type":"text"}]},{"type":"heading","attrs":{"level":4,"textAlign":null},"content":[{"text":"Key Project Facts","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}},{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"10-storey rental housing building ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"74 new rental homes, including at least 17 affordable homes and family-sized units ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Mass timber construction and geothermal energy systems ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"78 bicycle parking spaces ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Private resident amenity space ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]}]},{"type":"heading","attrs":{"level":4,"textAlign":null},"content":[{"text":"Key Project Milestones","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"2022","type":"text","marks":[{"type":"bold"}]},{"text":": CreateTO and City partners launch the Mass Timber Pilot Program. ","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"2023/2024","type":"text","marks":[{"type":"bold"}]},{"text":": Community consultation and submission of an Official Plan and Zoning By-Law Amendment. ","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"2024:","type":"text","marks":[{"type":"bold"}]},{"text":" Planning approvals are secured for the development. ","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"2025","type":"text","marks":[{"type":"bold"}]},{"text":": Site preparation begins, including the deconstruction of the existing vacant home. Check out a timelapse and deconstruction photos below. ","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Summer 2026:","type":"text","marks":[{"type":"bold"}]},{"text":" Construction begins for CreateTO's first public builder project. ","type":"text"}]}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Have a question about the 1113 – 1125 Dundas Street West Mass Timber Pilot project or want to sign up for project updates? If so, email ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#335A52"}}]},{"text":"masstimber@createto.ca","type":"text","marks":[{"type":"link","attrs":{"href":"mailto:masstimber@createto.ca","uuid":null,"anchor":null,"target":"_blank","linktype":"url"}},{"type":"textStyle","attrs":{"color":"#335A52"}},{"type":"underline"}]},{"text":" ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#335A52"}}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Note: The address for this project is 1113-1125 Dundas Street West, but the site is commonly referred to as 1113-1117 Dundas Street West.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#335A52"}},{"type":"italic"}]},{"text":" ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#335A52"}}]}]},{"type":"blok","attrs":{"id":"89bbde30-8e71-4711-8923-f445a9ad6471","body":[{"_uid":"i-048905ee-170b-489f-af5c-dd651825bfc2","video":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"tracks":[],"component":"video","youtubeEmbed":"https://youtu.be/4WAwtkJnZbg"}]}},{"type":"blok","attrs":{"id":"512d9775-6e17-497f-9339-4497e28a6f48","body":[{"_uid":"i-77a598dc-deb0-4f02-86ba-d84f8910e805","images":[{"id":86547215287988,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017201/1920x1280/c10eac3059/deconstruction-gif.gif","copyright":"","fieldtype":"asset","meta_data":{}},{"id":86547557422786,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017201/1153x1728/12256fd39f/mass-timber-deconstruction-9.jpg","copyright":"","fieldtype":"asset","meta_data":{}},{"id":86547557398209,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017201/1153x1728/6d8b8d6dde/mass-timber-deconstruction-11.jpg","copyright":"","fieldtype":"asset","meta_data":{}},{"id":86547557377727,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017201/1153x1728/6fa84bab32/mass-timber-deconstruction-2.jpg","copyright":"","fieldtype":"asset","meta_data":{}},{"id":86547557385920,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1017201/1944x1297/e750272fc3/mass-timber-deconstruction-7.jpg","copyright":"","fieldtype":"as