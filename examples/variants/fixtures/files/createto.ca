0 32 32" xmlns="http://www.w3.org/2000/svg"><path class="" d="m16.7 23.5-1.4-1.4 5-5.1H8v-2h12.3l-5-5.1 1.4-1.4L24 16z"></path></svg></span></span></a><h3 class="h2 NewsHero-module__kIkzbq__title">What&#x27;s happening at CreateTO</h3><a class="Link-module__ck364G__link hidden-up-lg Action-module__4gXbIq__action Action-module__4gXbIq__action__isSmall" href="/news"><span class="Action-module__4gXbIq__inner"><span class="Action-module__4gXbIq__text">View All News</span><span aria-hidden="true" class="IconAction-module__LaarvW__wrapper IconAction-module__LaarvW__wrapper__isClear IconAction-module__LaarvW__wrapper__isSizeXs Action-module__4gXbIq__icon Action-module__4gXbIq__icon__right"><svg aria-hidden="true" class="Icon-module__DNOlPq__icon" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path class="" d="m16.7 23.5-1.4-1.4 5-5.1H8v-2h12.3l-5-5.1 1.4-1.4L24 16z"></path></svg></span></span></a></div><div class="NewsHero-module__kIkzbq__content"><div class="Media-module__xdTpBq__wrapper Media-module__xdTpBq__wrapper__isFill NewsHero-module__kIkzbq__media"><figure class="Figure-module__yPjjRG__wrapper Media-module__xdTpBq__inner"><img alt="" title="" loading="lazy" decoding="async" data-nimg="fill" class="Image-module__gZOsHa__image" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/440x250/smart 440w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/640x364/smart 640w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/768x437/smart 768w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/992x565/smart 992w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/1080x615/smart 1080w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/1200x683/smart 1200w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/1400x797/smart 1400w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/1920x1093/smart 1920w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/2048x1166/smart 2048w, https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/3840x2185/smart 3840w" src="https://a-us.storyblok.com/f/1017201/1200x627/d41395f46b/annual-report-3-4.png/m/3840x2185/smart"/></figure></div><div class="theme theme__greenMedium NewsHero-module__kIkzbq__card"><div class="NewsHero-module__kIkzbq__cardAuthoring"><span class="NewsHero-module__kIkzbq__cardCategory"></span><time class="" dateTime="2026-04-27T14:39:59.897Z">April 27</time></div><span class="h4 NewsHero-module__kIkzbq__cardTitle">CreateTO&#x27;s 2025 Annual Report</span><p class="body-md-serif NewsHero-module__kIkzbq__cardDescription">Building the city we love requires consistency and a long‑term view. This past year, we continued our work supporting City Divisions, Agencies and Corporations, delivering affordable housing and advancing the transformation of the Port Lands. Our 2025 Annual Report reflects steady progress in using public real estate to meet Toronto’s evolving needs.</p><div class="NewsHero-module__kIkzbq__cardAction"><a class="Link-module__ck364G__link Action-module__4gXbIq__action Action-module__4gXbIq__action__isSmallSecondary" href="/news/createto-s-2025-annual-report"><span class="Action-module__4gXbIq__inner"><span aria-hidden="true" class="IconAction-module__LaarvW__wrapper IconAction-module__LaarvW__wrapper__isClear IconAction-module__LaarvW__wrapper__isSizeXs Action-module__4gXbIq__icon Action-module__4gXbIq__icon__left"><svg aria-hidden="true" class="Icon-module__DNOlPq__icon" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path class="" d="m16.7 23.5-1.4-1.4 5-5.1H8v-2h12.3l-5-5.1 1.4-1.4L24 16z"></path></svg></span><span class="Action-module__4gXbIq__text">Learn more<span class="visuallyHidden"> about CreateTO&#x27;s 2025 Annual Report</span></span></span></a></div></div></div></div></div><section class="theme__inherit section section__paddingForced"><div class="container"><div class="SocialCard-module__lGZ0nW__wrapper"><div class="theme theme__orange SocialCard-module__lGZ0nW__inner"><h2 class="h3 SocialCard-module__lGZ0nW__title">Stay Up To Date</h2><div class="SocialCard-module__lGZ0nW__content"><div class="">Follow us on LinkedIn or X and stay up-to-date with the latest happenings at CreateTO! Stay connected by asking questions, giving feedback, and participating in discussions. We value your opinions and want to hear from you.</div><div class="SocialCard-module__lGZ0nW__links"><a class="Link-module__ck364G__link Action-module__4gXbIq__action Action-module__4gXbIq__action__isSocial" href="https://twitter.com/_createto" target="" id="7fa9567c-6d2d-4197-85c1-ab4eb38dcb5ahttps://twitter.com/_createto"><span class="Action-module__4gXbIq__inner"><span aria-hidden="true" class="IconAction-module__LaarvW__wrapper IconAction-module__LaarvW__wrapper__isClear IconAction-module__LaarvW__wrapper__isSizeMd Action-module__4gXbIq__icon Action-module__4gXbIq__icon__left"><svg aria-hidden="true" class="Icon-module__DNOlPq__icon" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path class="" d="M24.3 3h4.4l-9.6 11 11.3 15h-8.9l-7-9.1-8 9.1H2.2l10.3-11.8L1.7 3h9.1l6.3 8.3L24.3 3zm-1.5 23.4h2.4L9.4 5.5H6.8l16 20.9z"></path></svg></span><span class="Action-module__4gXbIq__text">X</span></span></a><a class="Link-module__ck364G__link Action-module__4gXbIq__action Action-module__4gXbIq__action__isSocial" href="https://www.linkedin.com/company/createto" target="" id="419d4c57-48ef-42b8-8b82-296996f925fbhttps://www.linkedin.com/company/createto"><span class="Action-module__4gXbIq__inner"><span aria-hidden="true" class="IconAction-module__LaarvW__wrapper IconAction-module__LaarvW__wrapper__isClear IconAction-module__LaarvW__wra